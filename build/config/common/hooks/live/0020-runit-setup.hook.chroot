#!/bin/bash
set -euo pipefail

echo "==> Switching init to runit"

# At this point live-build has installed all package lists, including live-config-systemd
# and systemd-sysv (pulled in as deps). We now replace systemd-sysv with runit-init.
#
# runit-init has Conflicts: systemd-sysv and Replaces: systemd-sysv.
# apt resolves this by removing systemd-sysv when installing runit-init,
# provided nothing else hard-depends on systemd-sysv at this point.
apt-get install -y runit-init

# Point /sbin/init at runit
update-alternatives --set init /sbin/runit-init 2>/dev/null || true

echo "==> runit-init installed, systemd-sysv removed"

# Create runit stage directories
mkdir -p /etc/runit/1.d /etc/runit/3.d

# Stage 1: system init
cat > /etc/runit/1 << 'EOF'
#!/bin/bash
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /run

hostname -F /etc/hostname 2>/dev/null || true

for script in /etc/runit/1.d/*; do
  [ -x "$script" ] && "$script"
done
EOF
chmod +x /etc/runit/1

# Stage 2: service supervision
cat > /etc/runit/2 << 'EOF'
#!/bin/bash
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

/etc/runit/core-services

exec /sbin/runsvdir -P /etc/runit/runsvdir/default
EOF
chmod +x /etc/runit/2

# Stage 3: shutdown
cat > /etc/runit/3 << 'EOF'
#!/bin/bash
for script in /etc/runit/3.d/*; do
  [ -x "$script" ] && "$script"
done
EOF
chmod +x /etc/runit/3

echo "==> runit stages written"
